# shortcut to this dotfiles path is $DOTFILES
# (not $ZSH: oh-my-zsh owns that variable)
export DOTFILES=$HOME/.dotfiles

# your project folder that we can `c [tab]` to
export PROJECTS=~/code

# keep PATH and fpath free of duplicates (nested shells re-run every path.zsh)
typeset -U path fpath

# use .localrc for SUPER SECRET CRAP and machine-specific stuff that you don't
# want in your public, versioned repo.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($DOTFILES/**/*.zsh)

# load the path files. Homebrew goes first so every other path.zsh can put
# things (like asdf shims) in front of it.
typeset -U path_files
path_files=(${(M)config_files:#*/homebrew/path.zsh} ${(M)config_files:#*/path.zsh})
for file in $path_files
do
  source $file
done

# add topic folders to fpath before compinit runs (inside oh-my-zsh)
source $DOTFILES/zsh/fpath.zsh

# oh-my-zsh: plugins, completion setup (compinit), terminal titles, sane
# defaults. Our topic files load after it, so our aliases, options and key
# bindings win.
export ZSH=$HOME/.oh-my-zsh
if [[ -f $ZSH/oh-my-zsh.sh ]]
then
  ZSH_THEME=""                       # keep our prompt (zsh/prompt.zsh)
  zstyle ':omz:update' mode reminder # `dot` updates it; just remind otherwise
  plugins=(gcloud)
  [[ -d ${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-autosuggestions ]] && plugins+=(zsh-autosuggestions)
  source $ZSH/oh-my-zsh.sh
else
  autoload -U +X bashcompinit && bashcompinit
  autoload -U +X compinit && compinit
fi

# load everything but the path and completion files
for file in ${${${config_files:#*/path.zsh}:#*/completion.zsh}:#*/zsh/fpath.zsh}
do
  source $file
done

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  source $file
done

unset config_files path_files file

# http://stackoverflow.com/questions/23128353/zsh-shortcut-ctrl-a-not-working
bindkey -e
