" Linked to ~/.vimrc by script/link. Works in terminal vim and MacVim.

set encoding=utf-8
scriptencoding utf-8

" Having a ~/.vimrc stops vim from loading its built-in defaults (incremental
" search, sane backspace, etc.), so load them explicitly first.
unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim

syntax on

set noeb vb t_vb=

" Wrap gitcommit file types at the appropriate length
filetype indent plugin on

" Linked to ~/.vim/colors by vim/links; silent! so a missing theme isn't fatal
silent! colorscheme desertExHoward

set guioptions-=T

if has('gui_running')
  set transparency=10
endif

set guifont=Inconsolata:h14
set visualbell
set list listchars=tab:»\ ,eol:¬

let g:ctrlp_working_path_mode = 0
let g:ctrlp_match_window_bottom = 1

"set number
"set autoindent
"set tabstop=2
"set shiftwidth=2
"set expandtab
"set showmatch
"set nocompatible
"au BufRead,BufNewFile *.handlebars,*.hbs set ft=handlebars
