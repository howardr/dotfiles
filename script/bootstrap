#!/usr/bin/env bash
#
# bootstrap: first-time setup on a new machine. Safe to re-run.
#
#   1. create git/gitconfig.symlink (asks for name/email) if it's missing
#   2. create ~/code
#   3. link dotfiles into place (script/link)
#   4. run `dot` to install/update everything else
#
# Usage: script/bootstrap [-n|--dry-run] [--no-dot]

set -e

cd "$(dirname "$0")/.."
DOTFILES_ROOT="$(pwd -P)"
. script/lib.sh

RUN_DOT=true
for arg in "$@"
do
  case "$arg" in
    -n|--dry-run) DRY_RUN=true ;;
    --no-dot) RUN_DOT=false ;;
    -h|--help) sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) fail "unknown option: $arg" ;;
  esac
done

echo ''

setup_gitconfig () {
  if [ -f git/gitconfig.symlink ]
  then
    return 0
  fi

  info 'setup gitconfig'
  if [ "$DRY_RUN" = "true" ]
  then
    info "would create git/gitconfig.symlink from git/gitconfig.symlink.example"
    return 0
  fi

  local git_credential='cache' git_authorname git_authoremail
  if [ "$(uname -s)" = "Darwin" ]
  then
    git_credential='osxkeychain'
  fi

  user ' - What is your github author name?'
  read -r -e git_authorname
  user ' - What is your github author email?'
  read -r -e git_authoremail

  sed -e "s/AUTHORNAME/$git_authorname/g" \
      -e "s/AUTHOREMAIL/$git_authoremail/g" \
      -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" \
      git/gitconfig.symlink.example > git/gitconfig.symlink

  success 'gitconfig'
}

setup_gitconfig

if [ ! -d "$HOME/code" ]
then
  run mkdir -p "$HOME/code"
  [ "$DRY_RUN" = "true" ] || success "created ~/code"
fi

info "linking dotfiles$([ "$DRY_RUN" = "true" ] && echo ' (dry run)')"
link_all

if [ "$RUN_DOT" = "true" ] && [ "$DRY_RUN" != "true" ] && [ "$(uname -s)" = "Darwin" ]
then
  echo ''
  info "running dot"
  "$DOTFILES_ROOT/bin/dot" || fail "dot failed"
fi

echo ''
echo '  All installed!'
