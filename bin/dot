#!/usr/bin/env bash
#
# dot: bring this machine up to date with the dotfiles. Safe to run any time.
#
#   1. git pull the dotfiles repo
#   2. link dotfiles into place (script/link)
#   3. with --brew: install Homebrew if needed, then `brew bundle` the Brewfile
#   4. install/update oh-my-zsh and zsh-autosuggestions
#   5. install asdf plugins and the versions in ~/.tool-versions
#
# Usage: dot [options]
#
#   -b, --brew       also install the Brewfile (script/bootstrap always does)
#   -u, --upgrade    also upgrade outdated Homebrew packages (implies --brew)
#   -d, --defaults   also apply macOS defaults (osx/set-defaults.sh)
#   -e, --edit       open the dotfiles in $EDITOR and exit
#   -h, --help       show this help

set -e

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
. "$DOTFILES_ROOT/script/lib.sh"

UPGRADE=false
BREW=false
DEFAULTS=false
FAILED=""

for arg in "$@"
do
  case "$arg" in
    -b|--brew) BREW=true ;;
    -u|--upgrade) UPGRADE=true; BREW=true ;;
    -d|--defaults) DEFAULTS=true ;;
    -e|--edit) exec "${EDITOR:-vim}" "$DOTFILES_ROOT" ;;
    -h|--help) sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "dot: unknown option: $arg"; sed -n '11,18p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
  esac
done

step () {
  echo ''
  printf "\033[1m› %s\033[0m\n" "$1"
}

# Run a step; on failure, warn and keep going so one broken step doesn't
# block the rest. dot exits non-zero at the end if anything failed.
attempt () {
  local name="$1"; shift
  if ! "$@"
  then
    warn "$name failed"
    FAILED="$FAILED $name"
  fi
}

update_repo () {
  local branch upstream
  branch="$(git -C "$DOTFILES_ROOT" symbolic-ref --short HEAD 2>/dev/null || true)"
  upstream="$(git -C "$DOTFILES_ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
  if [ -z "$upstream" ]
  then
    warn "branch '${branch:-detached}' has no upstream; skipping git pull"
    return 0
  fi
  git -C "$DOTFILES_ROOT" pull --ff-only --quiet || return 1
  success "up to date with $upstream"
}

install_homebrew () {
  if ! command -v brew >/dev/null 2>&1
  then
    if [ -x /opt/homebrew/bin/brew ]
    then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    else
      info "installing Homebrew"
      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || return 1
      eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
  fi

  brew update --quiet || warn "brew update failed; continuing"

  if [ "$UPGRADE" = "true" ]
  then
    brew bundle install --file "$DOTFILES_ROOT/Brewfile" --upgrade
  else
    brew bundle install --file "$DOTFILES_ROOT/Brewfile" --no-upgrade
  fi
}

# clone_or_pull URL DIR
clone_or_pull () {
  if [ -d "$2/.git" ]
  then
    git -C "$2" pull --ff-only --quiet || return 1
    success "updated $(tildify "$2")"
  else
    git clone --quiet --depth=1 "$1" "$2" || return 1
    success "installed $(tildify "$2")"
  fi
}

install_oh_my_zsh () {
  local omz="$HOME/.oh-my-zsh"
  # Plain git clone on purpose: oh-my-zsh's installer would replace ~/.zshrc.
  clone_or_pull https://github.com/ohmyzsh/ohmyzsh.git "$omz" || return 1
  # Tell oh-my-zsh's update reminder that we just updated.
  mkdir -p "$omz/cache"
  echo "LAST_EPOCH=$(( $(date +%s) / 60 / 60 / 24 ))" > "$omz/cache/.zsh-update"

  clone_or_pull https://github.com/zsh-users/zsh-autosuggestions \
    "$omz/custom/plugins/zsh-autosuggestions"
}

install_asdf_tools () {
  local tool_versions="$HOME/.tool-versions" plugin _rest
  if ! command -v asdf >/dev/null 2>&1 && [ -f "$HOME/.asdf/asdf.sh" ]
  then
    . "$HOME/.asdf/asdf.sh"
  fi
  if ! command -v asdf >/dev/null 2>&1
  then
    warn "asdf not installed; skipping"
    return 0
  fi
  [ -f "$tool_versions" ] || { warn "no ~/.tool-versions; skipping"; return 0; }

  while read -r plugin _rest <&3 || [ -n "$plugin" ]
  do
    case "$plugin" in ''|'#'*) continue ;; esac
    if ! asdf plugin list 2>/dev/null | grep -qx "$plugin"
    then
      asdf plugin add "$plugin" || return 1
      success "added asdf plugin $plugin"
    fi
  done 3< "$tool_versions"

  (cd "$HOME" && asdf install)
}

apply_defaults () {
  "$DOTFILES_ROOT/osx/set-defaults.sh"
  success "macOS defaults applied (some need a logout to take effect)"
}

step "dotfiles"
attempt "git pull" update_repo

step "links"
attempt "link" link_all

step "homebrew"
if [ "$BREW" = "true" ] && [ "$(uname -s)" = "Darwin" ]
then
  attempt "homebrew" install_homebrew
else
  printf "\033[2m  skipped Homebrew (run dot --brew to install the Brewfile)\033[0m\n"
fi

step "oh-my-zsh"
attempt "oh-my-zsh" install_oh_my_zsh

step "asdf"
attempt "asdf" install_asdf_tools

if [ "$DEFAULTS" = "true" ]
then
  step "macOS defaults"
  attempt "defaults" apply_defaults
fi

echo ''
if [ -n "$FAILED" ]
then
  fail "finished with errors:$FAILED"
fi
success "all done. Open a new shell to pick up changes."
