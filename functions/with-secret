# Usage: with-secret NAME [NAME...] -- command [args...]
# Runs a single command with secrets from the macOS Keychain (stored via
# `secret-set`) exported as env vars. Secrets are exported in a subshell, so
# they never persist in the current shell and never appear on the command line.
#
#   secret-set GITHUB_TOKEN
#   with-secret GITHUB_TOKEN -- gh api user
emulate -L zsh

local -a names
while (( $# )) && [[ $1 != -- ]]; do
  names+=("$1")
  shift
done

if [[ $1 != -- || ${#names} -eq 0 || $# -lt 2 ]]; then
  print -u2 "usage: with-secret NAME [NAME...] -- command [args...]"
  return 2
fi
shift

(
  local name value
  for name in $names; do
    if [[ ! $name =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]]; then
      print -u2 "with-secret: invalid name: $name"
      exit 2
    fi
    value=$(security find-generic-password -a "$USER" -s "env/$name" -w 2>/dev/null) || {
      print -u2 "with-secret: missing secret: $name (add it with: secret-set $name)"
      exit 1
    }
    export "$name=$value"
  done
  "$@"
)
