# Usage: secret-rm NAME
# Deletes a secret stored with `secret-set`.
emulate -L zsh

if [[ $# -ne 1 || ! $1 =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]]; then
  print -u2 "usage: secret-rm NAME"
  return 2
fi

if security delete-generic-password -a "$USER" -s "env/$1" >/dev/null 2>&1; then
  print "deleted secret: $1"
else
  print -u2 "secret-rm: no secret named $1"
  return 1
fi
