# Usage: secret-set NAME
# Stores a secret in the macOS login Keychain (service "env/NAME") for use with
# `with-secret`. Prompts for the value so it never lands in shell history.
# Re-running with an existing NAME replaces the stored value.
emulate -L zsh

if [[ $# -ne 1 || ! $1 =~ '^[A-Za-z_][A-Za-z0-9_]*$' ]]; then
  print -u2 "usage: secret-set NAME   (NAME must be a valid env var name)"
  return 2
fi

security add-generic-password -U -a "$USER" -s "env/$1" -l "env/$1" -w
