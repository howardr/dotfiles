{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "webfetch": "allow"
  },
  "plugin": ["@mohak34/opencode-notifier@latest", "./plugins/cmux"],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "asdf",
        "exec",
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--redact-network-headers"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
