# source -> destination (relative to ~). See script/link and README.md.
opencode.jsonc -> .config/opencode/opencode.jsonc
# silent notifier config, used inside cmux via cmux/env.zsh
opencode-notifier.cmux.json -> .config/opencode/opencode-notifier.cmux.json
reflect-mcp-bridge.mjs -> .config/opencode/reflect-mcp-bridge.mjs
# TUI settings. "system" theme leaves the background transparent so Ghostty's
# background-opacity/blur show through (font comes from Ghostty too).
tui.json -> .config/opencode/tui.json
# OpenCode 2.0 terminal settings (theme, tabs, sessions, keybinds).
# Session tabs are off because cmux already gives each session its own tab.
cli.json -> .config/opencode/cli.json
